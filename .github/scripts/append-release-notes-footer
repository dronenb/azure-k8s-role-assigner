#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
  echo "usage: $0 <version> <release-notes-file> [image-digest] [chart-digest]" >&2
  exit 1
fi

version="$1"
release_notes_file="$2"
chart_version="${version#v}"
image_version="${version#v}"
image_digest="${3:-}"
chart_digest="${4:-}"

image_ref="ghcr.io/dronenb/azure-k8s-role-assigner:${image_version}"
chart_ref="ghcr.io/dronenb/charts/azure-k8s-role-assigner:${chart_version}"
if [ -n "$image_digest" ]; then
  image_ref="ghcr.io/dronenb/azure-k8s-role-assigner@${image_digest}"
fi
if [ -n "$chart_digest" ]; then
  chart_ref="ghcr.io/dronenb/charts/azure-k8s-role-assigner@${chart_digest}"
fi

cat >> "$release_notes_file" <<EOF

## Images

The controller image is published to GHCR:

\`\`\`bash
docker pull ${image_ref}
docker pull ghcr.io/dronenb/azure-k8s-role-assigner:latest
\`\`\`

Verify the image signature with cosign:

\`\`\`bash
cosign verify ${image_ref} \\
  --certificate-identity-regexp="https://github.com/dronenb/azure-k8s-role-assigner" \\
  --certificate-oidc-issuer="https://token.actions.githubusercontent.com"
\`\`\`

## Helm Chart

The Helm chart is published as an OCI artifact and attached to this GitHub Release.

Chart artifact reference:

\`\`\`text
${chart_ref}
\`\`\`

EOF

if [ -n "$chart_digest" ]; then
  cat >> "$release_notes_file" <<EOF

The chart OCI digest is \`${chart_digest}\`.
EOF
fi

cat >> "$release_notes_file" <<EOF

Install the chart from GHCR:

\`\`\`bash
helm upgrade --install azure-k8s-role-assigner \\
  oci://ghcr.io/dronenb/charts/azure-k8s-role-assigner \\
  --version ${chart_version} \\
  --namespace azure-k8s-role-assigner \\
  --create-namespace
\`\`\`
EOF

if [ -z "$image_digest" ] || [ -z "$chart_digest" ]; then
  cat >> "$release_notes_file" <<EOF

Digest-pinned image and chart references are added to the final GitHub Release notes after publishing completes.
EOF
fi
